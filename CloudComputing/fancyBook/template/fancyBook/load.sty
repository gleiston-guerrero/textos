\DeclareRobustCommand{\versiontemplatemagazinestyleud}{1.0}
\RequirePackage{\pathtemplate/loadOptions}
\ProcessPgfOptions{/DATEMPLATE}	
%-------------------------------------------
%-------INICIO configuraciones -------------
%-------------------------------------------
\geometry{
  paper=letterpaper,
  inner=3.0cm,
  outer=2.2cm,
  top=2.8cm,
  bottom=2.5cm,
  bindingoffset=0.5cm, % extra para encuadernación
  headheight=14pt,
  headsep=0.5cm,
  footskip=1.2cm
}

\setlength{\parindent}{1.5em} % sangría normal
\setlength{\JustifyingParindent}{\parindent} % para que \justifying respete la sangría
\setlength{\parskip}{0.55\baselineskip plus 0.1\baselineskip minus 0.05\baselineskip} % más espacio entre párrafos

\ifnotindentall	
	\setlength{\JustifyingParindent}{0mm}
\fi

%==============================
% PRIMEROS PÁRRAFOS SIN SANGRÍA
%==============================
\RequirePackage{etoolbox}

\AfterEndEnvironment{figure}{\par\noindent\ignorespaces}
\AfterEndEnvironment{table}{\par\noindent\ignorespaces}
\AfterEndEnvironment{wrapfigure}{\par\noindent\ignorespaces}
\AfterEndEnvironment{itemize}{\par\noindent\ignorespaces}
\AfterEndEnvironment{enumerate}{\par\noindent\ignorespaces}
\AfterEndEnvironment{description}{\par\noindent\ignorespaces}
%==============================
% FIN PÁRRAFOS SIN SANGRÍA
%==============================


\newcommand{\colorprovide}[2]{\providecolor{#1}{named}{#2}}
%----------bibliografia----------------
\ifbibunits	
	\RequirePackage[sectionbib]{bibunits}
	\defaultbibliographystyle{\bibliographystyletemplate}
	\bibliographyunit[\chapter]
	\defaultbibliography{\bibliographysrc}
\fi
